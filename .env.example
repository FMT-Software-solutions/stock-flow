VITE_SUPABASE_URL=supabase_url_here
VITE_SUPABASE_ANON_KEY=supabase_anon_key_here

# Where "Download the update" sends people. Falls back to an empty string in
# code, so if this is missing the button opens nothing at all.
VITE_DOWNLOADS_PAGE_URL=https://fmtsoftware.com/marketplace/stockflow

# fmt-ss-backend — SMS sending and Paystack credit purchases go through it.
# Required: every VITE_ value is compiled into the bundle at build time, so a
# release built without this ships pointing at a backend on the customer's own
# machine and SMS fails with "Failed to fetch". The build refuses to run
# without it. Use http://localhost:3001/api only when running it locally.
VITE_BACKEND_URL=https://api.fmtsoftware.com/api


# These should be set in your Supabase project's edge function secrets
# RESEND_API_KEY=your_resend_api_key_here

# Cloudinary configuration for image uploads 
# CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional: Set to 'development' to include debug info in error responses
# ENVIRONMENT=development
